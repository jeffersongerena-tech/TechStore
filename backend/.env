# Configuración de Base de Datos (XAMPP MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=techstore_db

# Seguridad JWT y Control de Acceso
SECRET_KEY=techstore_clave_secreta_segura_sena_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# En false permite probar directamente los endpoints en Swagger/Postman (Actividad 4)
# usando el usuario administrador por defecto si no se envía token Bearer.
# Cambia a true en Actividad 6 para exigir inicio de sesión obligatorio en cada petición.
REQUIRE_AUTH=false
